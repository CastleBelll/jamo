[gd_resource type="StandardMaterial3D" format=3]

; Golden individual - polished metal with a weak emission lift. Doc v0.3
; section 9.3 asks for metal plus a small glow; the world Environment has no
; glow pass on purpose, so this never turns into bloom (doc v0.3 section 24).
[resource]
resource_name = "JamoGold"
albedo_color = Color(0.898, 0.729, 0.298, 1)
metallic = 1.0
metallic_specular = 0.75
roughness = 0.25
emission_enabled = true
emission = Color(0.98, 0.78, 0.35, 1)
emission_energy_multiplier = 0.35
