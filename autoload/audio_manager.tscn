[gd_scene load_steps=3 format=3]

; AudioManager autoload. The player pool is part of the scene on purpose: no
; AudioStreamPlayer is ever created at runtime, so a click costs a stream
; assignment and nothing else. Doc v0.3 sections 19.1 and 36.
; Add or remove SfxPlayer children here to change how many sounds can overlap.

[ext_resource type="Script" path="res://autoload/audio_manager.gd" id="1_audio"]
[ext_resource type="Resource" path="res://resources/audio/sfx_library.tres" id="2_library"]

[node name="AudioManager" type="Node"]
process_mode = 3
script = ExtResource("1_audio")
library = ExtResource("2_library")

[node name="SfxPool" type="Node" parent="."]

[node name="SfxPlayer0" type="AudioStreamPlayer" parent="SfxPool"]
bus = &"SFX"

[node name="SfxPlayer1" type="AudioStreamPlayer" parent="SfxPool"]
bus = &"SFX"

[node name="SfxPlayer2" type="AudioStreamPlayer" parent="SfxPool"]
bus = &"SFX"

[node name="SfxPlayer3" type="AudioStreamPlayer" parent="SfxPool"]
bus = &"SFX"

[node name="SfxPlayer4" type="AudioStreamPlayer" parent="SfxPool"]
bus = &"SFX"

[node name="SfxPlayer5" type="AudioStreamPlayer" parent="SfxPool"]
bus = &"SFX"

[node name="SfxPlayer6" type="AudioStreamPlayer" parent="SfxPool"]
bus = &"SFX"

[node name="SfxPlayer7" type="AudioStreamPlayer" parent="SfxPool"]
bus = &"SFX"

[node name="BgmPlayer" type="AudioStreamPlayer" parent="."]
bus = &"BGM"
