; Engine configuration file.
; Regenerate defaults from the Godot editor rather than hand-editing.

config_version=5

[application]

config/name="JAMO"
config/description="한글 단어 조합 x 슬롯/덱빌딩 x 로그라이트 x 클릭커"
config/features=PackedStringArray("4.7", "Forward Plus")
run/main_scene="res://scenes/hub/last_library.tscn"

[audio]

buses/default_bus_layout="res://resources/audio/default_bus_layout.tres"

[autoload]

Meta="*res://scripts/persistence/meta_store.gd"
Sfx="*res://scripts/audio/sfx_player.gd"
RunLog="*res://scripts/log/run_logger.gd"

[gui]

theme/custom="res://resources/ui/theme.tres"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[input]

click={
