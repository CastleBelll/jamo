[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/ui/word_tree.gd" id="1_tree"]

; One column per word category, one static Button per tree slot. The script
; only fills text in and folds unused slots away, so the whole layout stays
; editable here. Doc v0.3 sections 19.1, 23.5 and 37.

[node name="WordTree" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_tree")
column_categories = Array[StringName]([&"fire", &"power", &"gold", &"energy", &"luck", &""])

[node name="Frame" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 24.0
offset_top = 88.0
offset_right = -24.0
offset_bottom = -24.0
grow_horizontal = 2
grow_vertical = 2

[node name="Panel" type="PanelContainer" parent="Frame"]
layout_mode = 2

[node name="Box" type="VBoxContainer" parent="Frame/Panel"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="TitleLabel" type="Label" parent="Frame/Panel/Box"]
layout_mode = 2
theme_override_font_sizes/font_size = 24
text = "단어 트리"

[node name="SummaryLabel" type="Label" parent="Frame/Panel/Box"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 17
text = "완성한 단어  0 / 10"

[node name="TargetLabel" type="Label" parent="Frame/Panel/Box"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 17
text = "목표 단어: 없음"

[node name="LegendLabel" type="Label" parent="Frame/Panel/Box"]
layout_mode = 2
theme_override_font_sizes/font_size = 14
text = "[완성] 이미 만든 단어  ·  [제작 가능] 지금 목표로 지정 가능  ·  [선행 잠금] 선행 단어 필요  ·  [미발견] 더 깊은 선행 필요"
autowrap_mode = 3

[node name="Scroll" type="ScrollContainer" parent="Frame/Panel/Box"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
follow_focus = true

[node name="Columns" type="HBoxContainer" parent="Frame/Panel/Box/Scroll"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 12

[node name="Col0" type="VBoxContainer" parent="Frame/Panel/Box/Scroll/Columns"]
custom_minimum_size = Vector2(185, 0)
layout_mode = 2
size_flags_vertical = 0
theme_override_constants/separation = 6

[node name="Title" type="Label" parent="Frame/Panel/Box/Scroll/Columns/Col0"]
layout_mode = 2
theme_override_font_sizes/font_size = 19
text = "화염"

[node name="Slot0" type="Button" parent="Frame/Panel/Box/Scroll/Columns/Col0"]
