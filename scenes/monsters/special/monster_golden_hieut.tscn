[gd_scene load_steps=6 format=3]

; Inherits the plain MonsterIeung scene: the golden individual reuses the same
; ring instead of a new glyph mesh, wears the gold material and adds the two
; primitive strokes that turn the ring into a ㅎ. Move them in the editor to
; retune the letter. Doc v0.3 section 9.6.

[ext_resource type="PackedScene" path="res://scenes/monsters/monster_ieung.tscn" id="1_base"]
[ext_resource type="Resource" path="res://resources/monsters/golden_hieut.tres" id="2_data"]
[ext_resource type="Material" path="res://materials/jamo_gold.tres" id="3_gold"]

[sub_resource type="BoxMesh" id="Mesh_hat_bar"]
size = Vector3(0.3, 0.055, 0.07)

[sub_resource type="BoxMesh" id="Mesh_hat_stroke"]
size = Vector3(0.055, 0.1, 0.07)

[node name="MonsterGoldenHieut" instance=ExtResource("1_base")]
monster_data = ExtResource("2_data")

[node name="Ring" parent="VisualRoot/Body/Lean" index="0"]
position = Vector3(0, 0.24, 0)
scale = Vector3(0.85, 0.85, 0.85)
surface_material_override/0 = ExtResource("3_gold")

[node name="HatBar" type="MeshInstance3D" parent="VisualRoot/Body/Lean" index="1"]
position = Vector3(0, 0.52, 0)
mesh = SubResource("Mesh_hat_bar")
surface_material_override/0 = ExtResource("3_gold")

[node name="HatStroke" type="MeshInstance3D" parent="VisualRoot/Body/Lean" index="2"]
position = Vector3(0, 0.62, 0)
mesh = SubResource("Mesh_hat_stroke")
surface_material_override/0 = ExtResource("3_gold")
