[gd_scene load_steps=6 format=3]

; Inherits the plain MonsterHieut scene. The golden individual reuses the same
; character model; jamo_gold.tres reaches its ink face through
; golden_hieut.tres (glyph_material), so the eyes, legs and paper edge stay
; as they are. Only the sparkle is added here. Doc v0.4 section 16.

[ext_resource type="PackedScene" path="res://scenes/monsters/monster_hieut.tscn" id="1_base"]
[ext_resource type="Resource" path="res://resources/monsters/golden_hieut.tres" id="2_data"]
[ext_resource type="Material" path="res://materials/gold_sparkle.tres" id="4_sparkle"]

[sub_resource type="BoxMesh" id="Mesh_sparkle"]
material = ExtResource("4_sparkle")
size = Vector3(0.02, 0.02, 0.02)

[sub_resource type="Curve" id="Curve_sparkle_fade"]
_data = [Vector2(0, 0), 0.0, 0.0, 0, 0, Vector2(0.35, 1), 0.0, 0.0, 0, 0, Vector2(1, 0), 0.0, 0.0, 0, 0]
point_count = 3

[node name="MonsterGoldenHieut" instance=ExtResource("1_base")]
monster_data = ExtResource("2_data")

; Doc v0.3 section 24: "아주 작은 sparkle", and no bloom. Always on, because the
; golden individual is meant to be spotted across the field before it expires.
