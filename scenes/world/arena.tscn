collision_mask = 0

[node name="CollisionShape3D" type="CollisionShape3D" parent="Ground"]
position = Vector3(0, -0.1, 0)
shape = SubResource("Shape_ground")

; Boundary of the field, inner faces on the paper edge. They stop a shove
; from carrying a body off the sheet between physics steps; the per-body
; clamp in JamoMonster is what keeps every glyph fully on the paper.
[node name="Walls" type="StaticBody3D" parent="."]
collision_layer = 1
collision_mask = 0

