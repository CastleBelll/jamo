; The desk the sheet lies on. Big enough to fill the camera frame so the
; background is wood, as on the title screen, rather than the clear colour.
[node name="Desk" type="MeshInstance3D" parent="."]
position = Vector3(0, -0.75, 0)
mesh = SubResource("Mesh_desk")
surface_material_override/0 = ExtResource("2_wood")

[node name="Ground" type="StaticBody3D" parent="."]
