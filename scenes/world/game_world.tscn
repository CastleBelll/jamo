[node name="Arena" parent="." instance=ExtResource("2_arena")]

; The 문장핵 sits at the rear centre of the paper sheet (-Z is away from the
; camera), so the approach reads bottom-to-top on screen. At -2.5 the book
; (1.26 deep at its 0.75 scale) keeps 0.6 m of paper behind it on the 7.5 m
; sheet instead of hanging off a corner. Doc v0.4 sections 6.1 and 39.
[node name="SentenceCore" parent="." node_paths=PackedStringArray("camera_rig") instance=ExtResource("18_core")]
position = Vector3(0, 0, -2.5)
camera_rig = NodePath("../CameraRig")

; Outer spawn points along the front and both sides of the 12 x 7.5 sheet, so
; a wave closes in on the 문장핵 from seven directions instead of one file. The
; SpawnManager jitters around whichever it picks and clamps the result onto the
; monster's own walkable rectangle. Move or add markers here. Doc v0.4 §39.
