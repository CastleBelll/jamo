[gd_resource type="Resource" script_class="MotionProfile" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/data/motion_profile.gd" id="1_script"]

[resource]
script = ExtResource("1_script")
profile_name = &"HEAVY_BOUNCE"
walk_animation = &"walk_bounce"
move_speed_multiplier = 0.75
step_frequency = 0.55
turn_speed = 3.5
idle_min = 1.2
idle_max = 2.6
avoidance_radius = 1.75
