[gd_resource type="Resource" script_class="NarrativeData" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/data/narrative_data.gd" id="1"]

[resource]
script = ExtResource("1")
events = {
"S_GREED": "모든 기록을 내 것으로 만들면, 아무도 기억할 수 없다.",
"S_M": "이 교정 기호를, 나는 알고 있다.",
"S_OPEN": ["글자들은 돌아갈 말을 잃었다.", "먼저, 하나의 뜻을 되찾자."],
"S_RETURN": "우리의 기록에는 서로 다른 목소리가 있었다.",
"S_SILENCE": "틀린 말을 지우다, 다른 말까지 지웠다.",
"S_SLICE_END": "나는 이 문장의 글씨를 알고 있다.",
"S_WORD": "읽어낸 뜻이 이 페이지의 법칙이 되었다."
}
sentence_stages = Array[String](["「□□□ □□□ □□□□□.」", "「우리는 □□□ □□□□□.」", "「우리는 서로를 □□□□□.」"])
boss_lines = {
"B_GREED": {
"after": "모아 둔 뜻은, 나눠 읽을 때 돌아왔다.",
"intro": "남은 것은 모두 내 것이다."
},
"B_SILENCE": {
"after": "침묵은 말을 없애는 것이 아니라, 다른 말을 기다리는 틈이었다.",
"intro": "아무 말도 남기지 마라."
}
}
